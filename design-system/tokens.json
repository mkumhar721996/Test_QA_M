{
  "color-fg": {
    "$type": "color",
    "$description": "Default body text color on light backgrounds.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.102, 0.102, 0.102],
      "hex": "#1a1a1a"
    }
  },
  "color-bg": {
    "$type": "color",
    "$description": "Default page/surface background color.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-primary": {
    "$type": "color",
    "$description": "Brand accent color used for primary actions.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.145, 0.388, 0.922],
      "hex": "#2563eb"
    }
  },
  "color-border": {
    "$type": "color",
    "$description": "Default hairline border color for surfaces and controls.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.820, 0.835, 0.859],
      "hex": "#d1d5db"
    }
  },
  "space-1": {
    "$type": "dimension",
    "$description": "Smallest spacing increment, used for tight gaps.",
    "$value": { "value": 4, "unit": "px" }
  },
  "space-2": {
    "$type": "dimension",
    "$description": "Base spacing unit, used for control padding.",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$description": "Medium spacing, used between grouped elements.",
    "$value": { "value": 16, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$description": "Large spacing, used for section/card padding.",
    "$value": { "value": 24, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$description": "Corner radius for small controls like chips and inputs.",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$description": "Corner radius for buttons.",
    "$value": { "value": 8, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$description": "Corner radius for cards and large surfaces.",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$description": "Small text, used for chips and helper text.",
    "$value": { "value": 12, "unit": "px" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$description": "Body text size, used for buttons and form controls.",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$description": "Heading text size, used for card titles.",
    "$value": { "value": 20, "unit": "px" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$description": "Default typeface stack for all UI text.",
    "$value": "Inter, system-ui, sans-serif"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$description": "Used for headings and emphasized labels like button text.",
    "$value": 700
  },
  "line-height-base": {
    "$type": "number",
    "$description": "Unitless line-height multiplier for body text.",
    "$value": 1.5
  },
  "shadow-sm": {
    "$type": "shadow",
    "$description": "Subtle elevation shadow used on cards.",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0.102, 0.102, 0.102],
        "alpha": 0.12,
        "hex": "#1a1a1a"
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 2, "unit": "px" },
      "blur": { "value": 8, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "button-primary-background": {
    "$type": "color",
    "$description": "Primary button fill.",
    "$value": "{color-primary}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$description": "Primary button label color.",
    "$value": "{color-bg}"
  },
  "button-primary-border": {
    "$type": "color",
    "$description": "Primary button border color.",
    "$value": "{color-primary}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$description": "Primary button corner radius.",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$description": "Secondary button fill.",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$description": "Secondary button label color.",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$description": "Secondary button border color.",
    "$value": "{color-primary}"
  },
  "button-secondary-radius": {
    "$type": "dimension",
    "$description": "Secondary button corner radius.",
    "$value": "{radius-md}"
  },
  "card-default-background": {
    "$type": "color",
    "$description": "Card surface fill.",
    "$value": "{color-bg}"
  },
  "card-default-foreground": {
    "$type": "color",
    "$description": "Card body text color.",
    "$value": "{color-fg}"
  },
  "card-default-border": {
    "$type": "color",
    "$description": "Card outline color.",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$description": "Card corner radius.",
    "$value": "{radius-lg}"
  }
}
